DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=DPS_Student_Details
PORT=3000
HOST=0.0.0.0

# ── Ollama AI Settings ──────────────────────────────
# Ollama base URL (default: local)
OLLAMA_URL=http://localhost:11434

# Model to use. Examples:
#   Local lightweight : llama3.2          (1B or 3B — fast, tiny)
#   Local lightweight : gemma3:1b
#   Cloud model       : llama3.2:cloud    (requires Ollama cloud account)
#   Cloud model       : gemma3:4b-cloud
OLLAMA_MODEL=llama3.2

# How often to refresh AI insights cache (in minutes). 0 = only on demand.
AI_CACHE_MINUTES=30
